// ================= VEHICLE =================
class Vehicle {
public:
    int vehicleID;
    string model;
    bool isAvailable;
    float rentPerDay;

    void addVehicle(int id, string m, float rent) {
        vehicleID = id;
        model = m;
        rentPerDay = rent;
        isAvailable = true;
    }

    void displayVehicle() {
        cout << "\nID: " << vehicleID
             << "\nModel: " << model
             << "\nRent/day: " << rentPerDay
             << "\nStatus: " << (isAvailable ? "Available" : "Not Available") << endl;
    }
};

// ================= CUSTOMER =================
class Customer {
public:
    int customerID;
    string name;

    void addCustomer(int id, string n) {
        customerID = id;
        name = n;
    }
};

// ================= BOOKING =================
class Booking {
public:
    int bookingID;
    int vehicleID;
    int customerID;
    int days;
    float totalAmount;
    bool isPaid;

    void createBooking(int bID, Vehicle &v, Customer &c, int d) {
        if (v.isAvailable) {
            bookingID = bID;
            vehicleID = v.vehicleID;
            customerID = c.customerID;
            days = d;

            totalAmount = days * v.rentPerDay;
            isPaid = false;

            v.isAvailable = false;

            generateBill(v, c);
        } else {
            cout << "\nVehicle not available!\n";
        }
    }

    void makePayment() {
        if (totalAmount == 0) {
            cout << "No booking found!\n";
            return;
        }

        float amount;

        while (!isPaid) {
            cout << "\nTotal Amount: " << totalAmount << endl;
            cout << "Enter FULL Payment: ";
            cin >> amount;

            if (amount == totalAmount) {
                isPaid = true;
                cout << "Payment successful!\n";
            } else {
                cout << "Invalid amount!\n";
            }
        }
    }

    void generateBill(Vehicle v, Customer c) {
        cout << "\n===== BILL =====\n";
        cout << "Booking ID: " << bookingID << endl;
        cout << "Customer: " << c.name << endl;
        cout << "Vehicle: " << v.model << endl;
        cout << "Days: " << days << endl;
        cout << "Total: " << totalAmount << endl;
        cout << "Payment Status: " << (isPaid ? "Paid" : "Pending") << endl;
        cout << "================\n";
    }
};

// ➕ ADD VEHICLE
void addNewVehicle(Vehicle v[], int &n) {
    int id;
    string model;
    float rent;

    cout << "Enter Vehicle ID: ";
    cin >> id;
    cout << "Enter Model: ";
    cin >> model;
    cout << "Enter Rent per day: ";
    cin >> rent;

    v[n].addVehicle(id, model, rent);

    // 🔥 CLOUD SAVE
    sendToSupabase(model, rent, true);

    n++;

    cout << "Vehicle added successfully!\n";
}

// 📋 DISPLAY
void displayVehicles(Vehicle v[], int n) {
    for (int i = 0; i < n; i++)
        v[i].displayVehicle();
}

// ================= MAIN =================
int main() {
    cout << "🚀 Program Started\n";

    Vehicle v[50];
    Customer c[5];
    Booking b;

    int vCount = 0;
    c[0].addCustomer(1, "Anshu");

    int choice;

    do {
        cout << "\n1.Add 2.Display 3.Book 4.Pay 5.Exit\n";
        cout << "Enter choice: ";
        cin >> choice;

        switch (choice) {
        case 1:
            addNewVehicle(v, vCount);
            break;

        case 2:
            displayVehicles(v, vCount);
            break;

        case 3: {
            int vid, days;
            cout << "Enter Vehicle ID and Days: ";
            cin >> vid >> days;

            for (int i = 0; i < vCount; i++) {
                if (v[i].vehicleID == vid) {
                    b.createBooking(1001, v[i], c[0], days);
                }
            }
            break;
        }

        case 4:
            b.makePayment();
            break;

        }

    } while (choice != 5);

    return 0;
}